@{ ViewData["Title"] = "Panel principal"; }
<div class="encabezado encabezado-panel"><div><span class="etiqueta">TU COMUNIDAD, CONECTADA</span><h1>Panel principal</h1><p class="secundario">Control sencillo de energía solar para comunidades rurales.</p></div><span class="chip">@(User.IsInRole("Administrador") ? "Administrador" : User.IsInRole("Tecnico") ? "Técnico" : "Usuario de comunidad")</span></div>
@if (User.IsInRole("Administrador") || User.IsInRole("Tecnico"))
{
<div class="indicadores indicadores-5">
<article class="indicador indicador-community"><div class="indicador-icono"><partial name="_Icono" model='@("community")' /></div><span>Comunidades</span><strong>@ViewBag.TotalComunidades</strong><small>Registradas</small></article>
<article class="indicador indicador-solar"><div class="indicador-icono"><partial name="_Icono" model='@("solar")' /></div><span>Sistemas solares</span><strong>@ViewBag.TotalSistemas</strong><small>Instalados</small></article>
<article class="indicador indicador-equipment"><div class="indicador-icono"><partial name="_Icono" model='@("equipment")' /></div><span>Equipos</span><strong>@ViewBag.TotalEquipos</strong><small>En inventario</small></article>
<article class="indicador indicador-energy"><div class="indicador-icono"><partial name="_Icono" model='@("energy")' /></div><span>Lecturas</span><strong>@ViewBag.TotalLecturas</strong><small>Registros de energía</small></article>
<article class="indicador indicador-alert"><div class="indicador-icono"><partial name="_Icono" model='@("alert")' /></div><span>Problemas activos</span><strong>@ViewBag.IncidenciasAbiertas</strong><small>Abiertos o en proceso</small></article>
</div>
@if (((List<AlertaConsumoVm>)ViewBag.AlertasConsumo).Count > 0)
{
<section class="tarjeta alerta-consumo" role="alert">
    <span class="etiqueta">ALERTA DE CONSUMO ALTO</span>
    <h2>El consumo superó la generación</h2>
    <p class="secundario">Período: últimos 30 días (@ViewBag.InicioPeriodoAlerta al @ViewBag.FinPeriodoAlerta).</p>
    <ul class="lista-alertas">
    @foreach (var alerta in (List<AlertaConsumoVm>)ViewBag.AlertasConsumo)
    {
        <li><strong>@alerta.Comunidad</strong> · @alerta.Sistema: consumo de @alerta.ConsumoKwh.ToString("N2") kWh frente a @alerta.GeneracionKwh.ToString("N2") kWh generados; diferencia de <strong>@alerta.DiferenciaKwh.ToString("N2") kWh</strong>.</li>
    }
    </ul>
</section>
}
<section class="tarjeta accesos"><span class="etiqueta">A UN CLIC</span><h2>Acciones rápidas</h2><p class="secundario">Accede directamente a las tareas de tu comunidad.</p><div class="acciones"><a class="boton boton-primario" asp-controller="Comunidades" asp-action="Index">Comunidades</a><a class="boton boton-contorno" asp-controller="Sistemas" asp-action="Index">Sistemas</a><a class="boton boton-contorno" asp-controller="Equipos" asp-action="Crear">Nuevo equipo</a><a class="boton boton-contorno" asp-controller="Lecturas" asp-action="Crear">Nueva lectura</a><a class="boton boton-contorno" asp-controller="Incidencias" asp-action="Crear">Reportar incidencia</a><a class="boton boton-contorno" asp-controller="Reportes" asp-action="Index">Ver reporte</a></div></section>
<section class="tarjeta tabla-scroll"><div class="titulo-tabla"><div><span class="etiqueta">ENERGÍA REGISTRADA</span><h2>Últimas lecturas</h2></div><a asp-controller="Lecturas" asp-action="Index">Ver todas <span aria-hidden="true">→</span></a></div><table><thead><tr><th>Fecha</th><th>Sistema</th><th>Generación</th><th>Consumo</th></tr></thead><tbody>
@foreach (var lectura in (List<LecturaEnergia>)ViewBag.UltimasLecturas)
{<tr><td>@lectura.FechaHora.ToString("dd/MM/yyyy")</td><td>@lectura.Sistema.Nombre</td><td>@lectura.GeneracionKwh kWh</td><td>@lectura.ConsumoKwh kWh</td></tr>}
</tbody></table>
@if (((List<LecturaEnergia>)ViewBag.UltimasLecturas).Count == 0)
{ <div class="estado-vacio"><partial name="_Icono" model='@("energy")' /><h3>Aún no hay lecturas</h3><p>Registra la primera lectura para ver la energía de tu comunidad.</p><a class="boton boton-primario" asp-controller="Lecturas" asp-action="Crear">Registrar lectura</a></div> }
</section>
}
else
{
<section class="tarjeta"><h2>Bienvenido a SolarGrid</h2><p class="secundario">Puedes revisar los problemas reportados por tu comunidad y avisar si hay una falla.</p><div class="acciones"><a class="boton boton-primario" asp-controller="Incidencias" asp-action="Index">Ver incidencias</a><a class="boton boton-contorno" asp-controller="Incidencias" asp-action="Crear">Reportar problema</a></div></section>
}
<section class="mensaje demo">Los datos iniciales son de ejemplo para presentar el proyecto. Las lecturas se ingresan manualmente; el sitio no se conecta a paneles reales.</section>
