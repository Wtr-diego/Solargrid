@model MapaComunidadesVm
@{
    ViewData["Title"] = "Comunidades y mapa de paneles";
    var panelesUbicados = Model.Paneles.Count(p => p.Latitud.HasValue && p.Longitud.HasValue);
}
<div class="encabezado">
    <div>
        <span class="etiqueta">SOLARGRID · MAPA INTERACTIVO</span>
        <h1>Comunidades</h1>
        <p class="secundario">Selecciona en el mapa el lugar donde está cada panel solar. Sus ubicaciones quedan guardadas.</p>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a class="boton boton-primario" asp-action="Crear">+ Nueva comunidad</a>
    }
</div>

<div class="indicadores indicadores-mapa" aria-label="Resumen del mapa">
    <article class="indicador"><span>Comunidades</span><strong>@Model.Comunidades.Count</strong></article>
    <article class="indicador"><span>Paneles registrados</span><strong>@Model.Paneles.Count</strong></article>
    <article class="indicador"><span>Con ubicación</span><strong>@panelesUbicados</strong></article>
    <article class="indicador"><span>Pendientes de ubicar</span><strong>@(Model.Paneles.Count - panelesUbicados)</strong></article>
</div>

<section class="tarjeta" aria-labelledby="tituloMapa">
    <div class="cabecera-mapa">
        <div>
            <h2 id="tituloMapa">Mapa de paneles solares</h2>
            <p class="secundario">Los marcadores muestran los paneles con ubicación guardada. Si es un panel antiguo, selecciónalo y haz clic sobre su posición.</p>
        </div>
        <div class="filtro-comunidad">
            <label for="filtroComunidad">Mostrar comunidad</label>
            <select id="filtroComunidad">
                <option value="">Todas las comunidades</option>
                @foreach (var comunidad in Model.Comunidades)
                {
                    <option value="@comunidad.IdComunidad">@comunidad.Nombre</option>
                }
            </select>
        </div>
    </div>
    <div class="grilla-mapa">
        <div>
            <div id="mapaPaneles" class="mapa-paneles" role="application" aria-label="Mapa para ubicar paneles solares">
                <p class="secundario mapa-cargando">Cargando el mapa…</p>
            </div>
            <p class="nota">Acerca el mapa, selecciona un panel y haz clic en el lugar exacto. El mapa necesita conexión a Internet; las ubicaciones quedan en SQL Server.</p>
        </div>
        <aside class="configuracion-mapa">
            <h3>Ubicar un panel</h3>
            <p class="secundario paso-mapa">1. Escoge un panel de los que ya registraste.<br />2. Marca su ubicación en el mapa.<br />3. Pulsa «Guardar ubicación».</p>
            <form asp-action="UbicarPanel" method="post" id="formUbicarPanel">
                <label for="panelSeleccionado">Panel solar</label>
                <select id="panelSeleccionado" name="idEquipo" aria-describedby="ayudaPanelUbicado" required>
                    <option value="">Selecciona un panel</option>
                    @foreach (var panel in Model.Paneles)
                    {
                        var ubicado = panel.Latitud.HasValue && panel.Longitud.HasValue;
                        <option value="@panel.IdEquipo" data-comunidad="@panel.IdComunidad">@(ubicado ? "✓ " : "")@panel.Codigo — @panel.Comunidad — @(ubicado ? "Ubicado" : "Sin ubicación")</option>
                    }
                </select>
                <p id="ayudaPanelUbicado" class="nota">✓ indica que el panel ya tiene una ubicación guardada.</p>
                <input type="hidden" id="latitudPanel" name="latitud" />
                <input type="hidden" id="longitudPanel" name="longitud" />
                <p id="estadoSeleccion" class="mensaje-seleccion" role="status">Selecciona un panel para comenzar.</p>
                <div class="coordenadas-preview">
                    <div><span>Latitud</span><strong id="textoLatitud">—</strong></div>
                    <div><span>Longitud</span><strong id="textoLongitud">—</strong></div>
                </div>
                <button type="submit" id="guardarUbicacion" class="boton boton-primario ancho" disabled>Guardar ubicación</button>
            </form>
            <form asp-action="QuitarUbicacion" method="post" id="formQuitarUbicacion">
                <input type="hidden" id="idPanelQuitar" name="idEquipo" />
                <button type="submit" id="quitarUbicacion" class="boton boton-contorno ancho" disabled>Quitar ubicación del panel</button>
            </form>
            <p class="nota">Quitar una ubicación no elimina el equipo. Puedes volver a marcarlo cuando quieras.</p>
        </aside>
    </div>
    <div class="paneles-registrados">
        <div class="cabecera-lista-paneles">
            <h3>Paneles que ya están registrados</h3>
            <span class="chip" id="cantidadFiltrados">@Model.Paneles.Count paneles</span>
        </div>
        <div id="listaPaneles" class="lista-paneles" aria-live="polite"></div>
        @if (Model.Paneles.Count == 0)
        {
            <p class="secundario">Todavía no tienes paneles. Registra uno desde <a asp-controller="Equipos" asp-action="Crear">Equipos → Nuevo equipo</a>, con el tipo «Panel».</p>
        }
    </div>
</section>

<section class="tarjeta tabla-scroll">
    <h2>Listado de comunidades</h2>
    <table>
        <thead><tr><th>ID</th><th>Nombre</th><th>Ubicación</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model.Comunidades)
            {
                <tr>
                    <td>@c.IdComunidad</td>
                    <td>@c.Nombre</td>
                    <td>@c.Ubicacion</td>
                    <td><span class="chip">@c.Estado</span></td>
                    <td>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Editar" asp-route-id="@c.IdComunidad">Editar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Comunidades.Count == 0)
    {
        <p class="secundario">Aún no hay comunidades registradas.</p>
    }
</section>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    @* La serialización estándar escapa los caracteres HTML peligrosos de nombres y códigos. *@
    <script type="application/json" id="datosPaneles">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Paneles))</script>
    <script src="~/js/mapa-comunidades.js" asp-append-version="true"></script>
}
