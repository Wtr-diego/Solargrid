@model List<Usuario>
@inject SolarGrid.Data.PresenciaUsuarios PresenciaUsuarios
@{
    ViewData["Title"] = "Usuarios";
    var grupos = new[]
    {
        (Rol: "Administrador", Titulo: "Administradores", Id: "administradores", Descripcion: "Cuentas con acceso a la administración de usuarios."),
        (Rol: "Tecnico", Titulo: "Técnicos", Id: "tecnicos", Descripcion: "Cuentas para la gestión técnica de los sistemas solares."),
        (Rol: "Comunidad", Titulo: "Usuarios de comunidad", Id: "comunidad", Descripcion: "Cuentas vinculadas a las comunidades registradas.")
    };
}

<div class="encabezado">
    <div>
        <span class="etiqueta">ADMINISTRACIÓN</span>
        <h1>Usuarios</h1>
        <p class="secundario" data-url-presencia="@Url.Action("Presencia", "Usuarios")">La presencia se basa en la actividad de los últimos dos minutos.</p>
    </div>
    <div class="acciones">
        <a class="boton boton-contorno" asp-action="Historial">Ver historial</a>
        <a class="boton boton-contorno" asp-action="SolicitudesRecuperacion">Solicitudes de recuperación</a>
        <a class="boton boton-primario" asp-action="Crear">+ Registrar usuario</a>
    </div>
</div>

@foreach (var grupo in grupos)
{
    var usuarios = Model.Where(u => u.Rol == grupo.Rol).ToList();
    <section class="tarjeta usuarios-grupo" aria-labelledby="titulo-@grupo.Id" data-rol="@grupo.Rol">
        <div class="titulo-tabla">
            <div>
                <h2 id="titulo-@grupo.Id">@grupo.Titulo</h2>
                <p class="secundario">@grupo.Descripcion</p>
            </div>
            <span class="chip estado-neutral">@usuarios.Count @(usuarios.Count == 1 ? "cuenta" : "cuentas")</span>
        </div>
        <div class="tabla-scroll">
        <table>
            <caption class="solo-lectores">Cuentas de @grupo.Titulo.ToLowerInvariant()</caption>
            <thead>
                <tr><th scope="col">Nombre</th><th scope="col">Correo</th><th scope="col">Comunidad</th><th scope="col">Estado</th><th scope="col">Presencia</th><th scope="col">Acciones</th></tr>
            </thead>
            <tbody>
                @if (usuarios.Count == 0)
                {
                    <tr><td colspan="6" class="usuarios-vacio">No hay cuentas registradas con este rol.</td></tr>
                }
                @foreach (var usuario in usuarios)
                {
                    var enLinea = usuario.Activo && PresenciaUsuarios.EnLinea(usuario.IdUsuario);
                    <tr>
                        <td><strong>@usuario.Nombre</strong></td>
                        <td>@usuario.Correo</td>
                        <td>@(usuario.Comunidad?.Nombre ?? "Sin comunidad")</td>
                        <td><span class="chip @(usuario.Activo ? "" : "chip-pendiente")">@(usuario.Activo ? "Activo" : "Inactivo")</span></td>
                        <td><span data-presencia-usuario="@usuario.IdUsuario" class="chip @(enLinea ? "estado-correcto" : "estado-neutral")">@(enLinea ? "En línea" : "Sin conexión")</span></td>
                        <td><a asp-action="Editar" asp-route-id="@usuario.IdUsuario">Editar</a> <a asp-action="Eliminar" asp-route-id="@usuario.IdUsuario">Eliminar</a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </section>
}
