@model List<Usuario>
@{ ViewData["Title"] = "Usuarios"; }

<div class="encabezado">
    <div>
        <span class="etiqueta">ADMINISTRACIÓN</span>
        <h1>Usuarios</h1>
        <p class="secundario">Administra las cuentas, sus roles y su acceso a SolarGrid.</p>
    </div>
    <a class="boton boton-primario" asp-action="Crear">+ Registrar usuario</a>
</div>

<section class="tarjeta tabla-scroll">
    @if (Model.Count == 0)
    {
        <p class="secundario">No hay usuarios registrados.</p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Comunidad</th><th>Estado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td><strong>@usuario.Nombre</strong></td>
                        <td>@usuario.Correo</td>
                        <td>@(usuario.Rol == "Tecnico" ? "Técnico" : usuario.Rol)</td>
                        <td>@(usuario.Comunidad?.Nombre ?? "Sin comunidad")</td>
                        <td><span class="chip @(usuario.Activo ? "" : "chip-pendiente")">@(usuario.Activo ? "Activo" : "Inactivo")</span></td>
                        <td><a asp-action="Editar" asp-route-id="@usuario.IdUsuario">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
