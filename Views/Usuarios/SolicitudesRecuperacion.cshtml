@model List<Historial>
@{ ViewData["Title"] = "Solicitudes de recuperación"; }

<div class="encabezado">
    <div>
        <h1>Solicitudes de recuperación</h1>
        <p class="secundario">Últimas 50 solicitudes. Verifica la identidad de quien solicita el cambio antes de restablecer su contraseña.</p>
    </div>
    <a class="boton boton-contorno" asp-action="Index">Volver a usuarios</a>
</div>
<section class="tarjeta tabla-scroll">
    @if (Model.Count == 0)
    {
        <p class="secundario">Aún no hay solicitudes.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Fecha</th><th>Cuenta</th><th>Teléfono indicado</th><th>Acción</th></tr></thead>
            <tbody>
                @foreach (var solicitud in Model)
                {
                    <tr>
                        <td>@solicitud.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@solicitud.Usuario.Correo</td>
                        <td>@solicitud.Detalle</td>
                        <td><a asp-action="Editar" asp-route-id="@solicitud.IdUsuario">Editar cuenta</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
