@model List<Equipo>
@{ ViewData["Title"] = "Equipos"; }
<div class="encabezado"><div><span class="etiqueta">INVENTARIO</span><h1>Equipos solares</h1><p class="secundario">Paneles, baterías, inversores y controladores registrados.</p></div><a class="boton boton-primario" asp-action="Crear">+ Registrar equipo</a></div>
<section class="tarjeta tabla-scroll"><table><thead><tr><th>Código</th><th>Tipo</th><th>Marca / Modelo</th><th>Sistema</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var e in Model)
{
<tr><td><strong>@e.Codigo</strong></td><td>@e.Tipo</td><td>@e.Marca @e.Modelo</td><td>@e.Sistema.Nombre</td><td><span class="chip">@e.Estado</span></td><td><a asp-action="Editar" asp-route-id="@e.IdEquipo">Editar</a></td></tr>
}
</tbody></table>@if(Model.Count == 0){<p class="secundario">No hay equipos registrados.</p>}</section>
