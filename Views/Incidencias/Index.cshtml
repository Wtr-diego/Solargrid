@model List<Incidencia>
@{ ViewData["Title"] = "Incidencias"; }
<div class="encabezado"><div><span class="etiqueta">SEGUIMIENTO</span><h1>Incidencias</h1><p class="secundario">Problemas reportados y estado de atención.</p></div><a class="boton boton-primario" asp-action="Crear">+ Reportar problema</a></div>
<section class="tarjeta tabla-scroll"><table><thead><tr><th>Fecha</th><th>Sistema</th><th>Descripción</th><th>Prioridad</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var i in Model)
{
<tr><td>@i.FechaCreacion.ToString("dd/MM/yyyy")</td><td>@i.Sistema.Nombre</td><td>@i.Descripcion</td><td><span class="chip">@i.Prioridad</span></td><td><span class="chip">@i.Estado</span></td><td>@if(User.IsInRole("Administrador") || User.IsInRole("Tecnico")){<a asp-action="Estado" asp-route-id="@i.IdIncidencia">Actualizar</a>}</td></tr>
}
</tbody></table>@if(Model.Count == 0){<p class="secundario">No hay problemas registrados.</p>}</section>
