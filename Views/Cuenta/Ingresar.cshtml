@model IngresoVm
@{
    ViewData["Title"] = "Iniciar sesión";
}
<div class="centrado">
    <section class="tarjeta login">
        <div class="ilustracion">☀</div>
        <h1>Iniciar sesión</h1>
        <p class="secundario">Accede al panel de administración de energía solar comunitaria.</p>
        <form asp-action="Ingresar" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="errores"></div>
            <label asp-for="Correo">Correo electrónico</label>
            <input asp-for="Correo" type="email" autocomplete="username" placeholder="usuario@solargrid.local" />
            <span asp-validation-for="Correo" class="errores"></span>
            <label asp-for="Contrasena">Contraseña</label>
            <div class="campo-contrasena">
                <input asp-for="Contrasena" type="password" autocomplete="current-password" />
                <partial name="_MostrarContrasena" model='@("Contrasena")' />
            </div>
            <span asp-validation-for="Contrasena" class="errores"></span>
            <button class="boton boton-primario ancho" type="submit">Entrar al sistema</button>
        </form>
        <p><a asp-action="OlvideContrasena">¿Olvidaste tu contraseña?</a></p>
        <p class="nota">Para la demostración utiliza las cuentas indicadas en el archivo LEEME.md.</p>
    </section>
</div>
