@{ ViewData["Title"] = "Recuperar acceso"; }

<div class="centrado">
    <section class="tarjeta login">
        <h1>Recuperar acceso</h1>
        <p>Contacta al administrador de SolarGrid e indícale el correo con el que ingresas.</p>
        <p>Una vez que verifique tu identidad, podrá restablecer tu contraseña.</p>
        <a class="boton boton-contorno" asp-action="Ingresar">Volver al inicio de sesión</a>
    </section>
</div>
