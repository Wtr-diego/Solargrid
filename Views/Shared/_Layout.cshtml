@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var manager = User.IsInRole("Administrador") || User.IsInRole("Tecnico");
    var links = new List<(string Controller, string Label, string Icon)> { ("Home", "Inicio", "home") };
    if (manager) links.AddRange(new[] { ("Comunidades", "Comunidades", "community"), ("Sistemas", "Sistemas solares", "solar"), ("Equipos", "Equipos", "equipment"), ("Lecturas", "Lecturas", "energy"), ("Reportes", "Reportes", "report") });
    links.Add(("Incidencias", "Incidencias", "alert"));
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <title>@ViewData["Title"] · SolarGrid</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/interfaz.css" asp-append-version="true" />
</head>
<body class="@(authenticated ? "con-sidebar" : "sin-sidebar")">
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
    <header class="barra">
        <a class="marca" asp-controller="Home" asp-action="Index"><span class="sol">☀</span> SolarGrid</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="boton-menu" type="button" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir menú de navegación"><partial name="_Icono" model='@("menu")' /></button>
            <span class="titulo-seccion">@ViewData["Title"]</span>
            <div class="sesion">
                <span>@User.Identity.Name</span>
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button class="boton boton-oscuro" type="submit">Cerrar sesión</button>
                </form>
            </div>
        }
        <button class="selector-tema" id="selector-tema" type="button" role="switch" aria-checked="false" aria-label="Modo oscuro" title="Cambiar a modo oscuro">
            <span class="selector-tema-perilla" aria-hidden="true">
                <svg class="tema-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
                </svg>
                <svg class="tema-luna" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" />
                </svg>
            </span>
        </button>
    </header>
    @if (authenticated)
    {
        <aside class="sidebar" id="menu-principal">
            <a class="marca sidebar-marca" asp-controller="Home" asp-action="Index"><span class="marca-icono"><partial name="_Icono" model='@("solar")' /></span>SolarGrid</a>
            <p class="nav-etiqueta">ESPACIO DE TRABAJO</p>
            <nav aria-label="Principal">
                @foreach (var link in links)
                {
                    var active = currentController == link.Controller;
                    <a asp-controller="@link.Controller" asp-action="Index" class="nav-enlace @(active ? "activo" : "")" aria-current="@(active ? "page" : null)">
                        <partial name="_Icono" model="@link.Icon" /><span>@link.Label</span>
                    </a>
                }
            </nav>
            <div class="sidebar-nota"><partial name="_Icono" model='@("energy")' /><strong>Energía que conecta</strong><span>Gestión solar para tu comunidad.</span></div>
        </aside>
    }
    <main class="contenedor" id="contenido" tabindex="-1">
        @if (TempData["Exito"] is string exito)
        {
            <div class="mensaje exito" role="status">@exito</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="mensaje error-mapa" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="pie">SolarGrid · Avance técnico · Datos de demostración</footer>
    <script src="~/js/interfaz.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
