<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/tema.js" asp-append-version="true"></script>
    <title>@ViewData["Title"] · SolarGrid</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="barra">
        <a class="marca" asp-controller="Home" asp-action="Index"><span class="sol">☀</span> SolarGrid</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav aria-label="Principal">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                @if (User.IsInRole("Administrador") || User.IsInRole("Tecnico"))
                {
                    <a asp-controller="Comunidades" asp-action="Index">Comunidades</a>
                    <a asp-controller="Sistemas" asp-action="Index">Sistemas solares</a>
                    <a asp-controller="Equipos" asp-action="Index">Equipos</a>
                    <a asp-controller="Lecturas" asp-action="Index">Lecturas</a>
                    <a asp-controller="Reportes" asp-action="Index">Reportes</a>
                }
                <a asp-controller="Incidencias" asp-action="Index">Incidencias</a>
            </nav>
            <div class="sesion">
                <span>@User.Identity.Name</span>
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button class="boton boton-oscuro" type="submit">Cerrar sesión</button>
                </form>
            </div>
        }
        <button class="selector-tema" id="selector-tema" type="button" role="switch" aria-checked="false" aria-label="Modo oscuro" title="Cambiar a modo oscuro">
            <span class="selector-tema-perilla" aria-hidden="true">
                <svg class="tema-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
                </svg>
                <svg class="tema-luna" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z" />
                </svg>
            </span>
        </button>
    </header>
    <main class="contenedor">
        @if (TempData["Exito"] is string exito)
        {
            <div class="mensaje exito" role="status">@exito</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="mensaje error-mapa" role="alert">@error</div>
        }
        @RenderBody()
    </main>
    <footer class="pie">SolarGrid · Avance técnico · Datos de demostración</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
